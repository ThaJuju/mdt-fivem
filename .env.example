DATABASE_URL="postgresql://user:password@localhost:5432/mdt_omerta?schema=public"

# Mot de passe du compte super-admin créé par le seed. Obligatoire, pas de valeur par défaut.
ADMIN_PASSWORD=""

# Force l'attribut Secure du cookie de session ("true"/"false").
# Par défaut, il est déduit de x-forwarded-proto : Secure uniquement si la
# requête arrive en HTTPS. À laisser vide sauf cas particulier.
SESSION_COOKIE_SECURE=
