DATABASE_URL="postgresql://user:password@localhost:5432/mdt_omerta?schema=public"

# Mot de passe du compte super-admin créé par le seed. Obligatoire, pas de valeur par défaut.
ADMIN_PASSWORD=""

# Force l'attribut Secure du cookie de session ("true"/"false").
# Par défaut, il est déduit de x-forwarded-proto : Secure uniquement si la
# requête arrive en HTTPS. À laisser vide sauf cas particulier.
SESSION_COOKIE_SECURE=

# Adresse et port d'écoute du serveur maison.
# En production derrière nginx, mettre HOSTNAME=127.0.0.1 : si le port reste
# joignable directement, on contourne nginx et tous les en-têtes de confiance
# qu'il pose (adresse client, protocole) redeviennent falsifiables.
PORT=3000
HOSTNAME=127.0.0.1

# Nombre de reverse proxys qui ajoutent leur entrée à X-Forwarded-For.
# nginx seul = 1 (défaut). Un CDN devant nginx = 2. Voir src/lib/client-ip.ts :
# se tromper vers le bas fait confiance à une adresse choisie par le client.
TRUSTED_PROXY_HOPS=1
